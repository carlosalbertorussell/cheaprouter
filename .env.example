# cheaprouter — environment configuration
#
# LOCAL DEVELOPMENT: copy to .env and fill in what you need. Never commit .env.
#
# HOSTED (MCPize or any HTTP deployment): do NOT set provider API keys as
# secrets. Callers bring their own keys in `api_keys` on every request (BYOK).
# Over HTTP the server ignores provider key env vars, so a key set here would
# not be used anyway — and if it were, any anonymous caller could spend it.
#
# ── Provider API keys (local stdio only) ──────────────────────────────────────
# Used ONLY when a caller omits a provider from `api_keys` AND either:
#   - the server runs over stdio (`python server.py --stdio`, e.g. Claude Desktop), or
#   - ARBITRAGE_ALLOW_ENV_KEYS=1 is set (explicit opt-in for a private HTTP
#     deployment you protect yourself — never on a public endpoint).
# Keys a caller passes in `api_keys` always win. Unset providers are excluded
# from routing.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# GROQ_API_KEY=gsk_...
# MISTRAL_API_KEY=...
# DEEPSEEK_API_KEY=sk-...
# DASHSCOPE_API_KEY=sk-...         # Alibaba Qwen via DashScope
# XAI_API_KEY=xai-...              # xAI Grok

# Opt in to the env-key fallback over HTTP. Leave empty on any shared or
# public deployment.
ARBITRAGE_ALLOW_ENV_KEYS=

# ── Routing configuration ─────────────────────────────────────────────────────

# Providers with latency above this threshold (ms) are excluded when
# latency_sensitive=True is passed to route_completion.
# Default: 300ms  (excludes CN-region providers — DeepSeek, Qwen — from LATAM)
LATENCY_THRESHOLD_MS=300

# Permanently block entire regions (comma-separated: us, eu, cn).
# Leave empty to allow all regions.
BLOCKED_REGIONS=

# ── History ───────────────────────────────────────────────────────────────────

# Path for the JSONL routing history file.
# Default: /tmp/routing_history.jsonl  (ephemeral on MCPize cloud — resets on redeploy)
# Override for local persistence: ARBITRAGE_HISTORY_FILE=./routing_history.jsonl
ARBITRAGE_HISTORY_FILE=/tmp/routing_history.jsonl


# ── Spend analytics (S1 — optional) ───────────────────────────────────────────
# Set both to persist routing history to Upstash Redis across MCPize redeploys.
# Leave unset to fall back to local JSONL (self-hosters need nothing here).
# Setup: docs/upstash-setup.md
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token
# Per-request timeout for Upstash calls, in seconds (default 2). History writes
# run in the background, so this bounds how long a pending write can delay a read.
# UPSTASH_TIMEOUT_S=2

# ── Provider health tracking (S8 — optional tuning) ───────────────────────────
# A provider failing more than HEALTH_THRESHOLD of its recent calls (over the
# last HEALTH_WINDOW records, once it has HEALTH_MIN_SAMPLES) is deprioritized
# in routing — moved behind healthy providers, never excluded.
HEALTH_WINDOW=50
HEALTH_MIN_SAMPLES=3
HEALTH_THRESHOLD=0.5
# Distinct sessions whose failures are needed to mark a provider unhealthy.
# Leave unset for the transport default: 2 over HTTP (hosted, many callers),
# 1 over local stdio (one user, every call is the anon session). A value set
# here always wins.
# HEALTH_MIN_SESSIONS=

# ── Price-table staleness guard (S4a) ─────────────────────────────────────────
# Prices live in prices.json with a verified_at date and max_age_days. When the
# table is older than max_age_days, routing and cost estimation refuse until
# prices are re-verified. Set this to 1 to downgrade the refusal to a warning.
ARBITRAGE_ALLOW_STALE_PRICES=
# Override the price-table location (default: ./prices.json)
# ARBITRAGE_PRICES_FILE=/path/to/prices.json

# ── Waist interaction (SP1d — optional) ───────────────────────────────────────
# When set, the router publishes an OBSERVED-tier price signal (metadata only:
# provider/model/tier/unit-price) to the shared price history after each
# completion, for the pricing side to validate the verified table against real
# spend. Off by default. Never carries content or keys.
ARBITRAGE_EMIT_OBSERVED=
