# token-arbitrage-mcp — environment configuration
#
# LOCAL DEVELOPMENT: Copy to .env and fill in your keys.
# MCPIZE CLOUD: Use `mcpize secrets set KEY value` — do NOT commit .env to Git.
#   mcpize secrets set ANTHROPIC_API_KEY sk-ant-...
#   mcpize secrets set OPENAI_API_KEY sk-...
#   (etc.)
# Secrets injected by MCPize are available as env vars at runtime; no .env needed.
#
# The server runs with any subset of providers — unconfigured ones are
# automatically excluded from routing decisions.

# ── Provider API keys ─────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...
MISTRAL_API_KEY=...
DEEPSEEK_API_KEY=sk-...
DASHSCOPE_API_KEY=sk-...           # Alibaba Qwen via DashScope
XAI_API_KEY=xai-...                # xAI Grok

# ── Routing configuration ─────────────────────────────────────────────────────

# Providers with latency above this threshold (ms) are excluded when
# latency_sensitive=True is passed to route_completion.
# Default: 300ms  (excludes CN-region providers — DeepSeek, Qwen — from LATAM)
LATENCY_THRESHOLD_MS=300

# Permanently block entire regions (comma-separated: us, eu, cn).
# Leave empty to allow all regions.
BLOCKED_REGIONS=

# ── History ───────────────────────────────────────────────────────────────────

# Path for the JSONL routing history file.
# Default: /tmp/routing_history.jsonl  (ephemeral on MCPize cloud — resets on redeploy)
# Override for local persistence: ARBITRAGE_HISTORY_FILE=./routing_history.jsonl
ARBITRAGE_HISTORY_FILE=/tmp/routing_history.jsonl


# ── Spend analytics (S1 — optional) ───────────────────────────────────────────
# Set both to persist routing history to Upstash Redis across MCPize redeploys.
# Leave unset to fall back to local JSONL (self-hosters need nothing here).
# Setup: docs/upstash-setup.md
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token
